# Local-only development database started by docker-compose.yml
DATABASE_URL=postgres://flow:flow_local_dev@127.0.0.1:54329/flow_studio
DATABASE_SSL=false

# Owner auth is optional in local development when both values are blank.
# Set both if you want to exercise the login flow locally.
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=

# Local S3-compatible relay started by docker-compose.yml (MinIO).
# Production should use Cloudflare R2 or another intentionally configured S3-compatible store.
R2_ENDPOINT=http://127.0.0.1:9000
R2_REGION=us-east-1
R2_FORCE_PATH_STYLE=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=flow
R2_SECRET_ACCESS_KEY=flow_local_secret
R2_BUCKET=flow-relay

# Paid generation remains disabled locally until Google + Inngest are configured.
GOOGLE_AUTH_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional until multi-profile encrypted storage is used.
CREDENTIAL_ENCRYPTION_KEY=

# Optional until the desktop companion is used.
COMPANION_TOKEN=

NEXT_PUBLIC_APP_NAME=Persistent AI Video Studio
