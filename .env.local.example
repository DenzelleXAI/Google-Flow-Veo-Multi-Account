# Local-only development database started by docker-compose.yml
DATABASE_URL=postgres://flow:flow_local_dev@127.0.0.1:54329/flow_studio
DATABASE_SSL=false

# The workspace/project CRUD path works with only PostgreSQL configured.
# Leave paid generation infrastructure blank until you are ready to test it.
GOOGLE_AUTH_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional until multi-profile encrypted storage is used.
CREDENTIAL_ENCRYPTION_KEY=

# Optional until the desktop companion is used.
COMPANION_TOKEN=

NEXT_PUBLIC_APP_NAME=Persistent AI Video Studio
