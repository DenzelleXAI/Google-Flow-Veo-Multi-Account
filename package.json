{
  "name": "google-flow-veo-multi-account",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/ensure-local-env.mjs && npm run local:up && npm run db:local:bootstrap && npm run db:local:check && next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:relay": "node --experimental-strip-types scripts/smoke-relay.mjs",
    "local:up": "docker compose up -d --wait postgres minio && docker compose run --rm minio-init",
    "local:down": "docker compose down",
    "local:reset": "docker compose down -v && docker compose up -d --wait postgres minio && docker compose run --rm minio-init",
    "db:bootstrap": "node scripts/db-bootstrap.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:local:up": "docker compose up -d --wait postgres",
    "db:local:down": "docker compose down",
    "db:local:reset": "docker compose down -v && docker compose up -d --wait postgres",
    "db:local:bootstrap": "node scripts/db-local-bootstrap.mjs",
    "db:local:check": "node scripts/db-local-check.mjs",
    "companion": "node companion/index.mjs",
    "companion:windows:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File companion/windows/install.ps1",
    "companion:windows:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File companion/windows/uninstall.ps1"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.64",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-storage": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@google/genai": "^2.21.0",
    "ai": "7.0.93",
    "inngest": "^4.20.0",
    "next": "16.3.3",
    "postgres": "^3.4.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
