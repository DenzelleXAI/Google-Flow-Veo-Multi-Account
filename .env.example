# App
NEXT_PUBLIC_APP_NAME=Persistent AI Video Studio

# Single-owner production access
# Required together on public production deployments. Keep both server-only.
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=

# PostgreSQL
DATABASE_URL=
DATABASE_SSL=true

# Google / Gemini / Veo
GOOGLE_AUTH_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Cloudflare R2 transient relay
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Credential encryption for user-managed API profiles
CREDENTIAL_ENCRYPTION_KEY=

# Durable jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Desktop companion
# Same random secret must be configured on server and companion.
COMPANION_TOKEN=
# Companion process only:
COMPANION_APP_URL=http://localhost:3000
COMPANION_DEVICE_NAME=Home PC
COMPANION_MEDIA_ROOT=D:\AI Video Studio
COMPANION_DEVICE_ID=
